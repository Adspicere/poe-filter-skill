# Only standalone skill files and repository metadata belong at the root.
/*
!/.gitignore
!/LICENSE
!/README.md
!/SKILL.md
!/agents/
!/references/
!/scripts/

# Exclude local dependencies, credentials, and generated files in allowed folders.
__pycache__/
*.py[cod]
.venv/
node_modules/
.env
.env.*
*.filter
*.filteragent-*
*.log
*.tmp
*.bak
